        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 는 「%2$@」 의 단축키입니다. 이 동작으로 옮길까요?"
          }
        }
      }
    },
    "%@ of %@ used" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
