          "stringUnit" : {
            "state" : "translated",
            "value" : "이 창은 크기를 바꿀 수 없습니다."
          }
        }
      }
    },
    "Three permissions\nfrom macOS" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 의\n허락 세 가지"
          }
        }
      }
    },
    "Tight, compressing and swapping" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠듯함, 압축과 스왑을 쓰는 중"
