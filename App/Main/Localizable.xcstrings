{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@ update failed" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ update failed"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 업데이트 실패"
          }
        }
      }
    },
    "%@ It won’t be downloaded again automatically." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 자동으로 다시 받지 않습니다."
          }
        }
      }
    },
    "%@ It won’t be downloaded again automatically. To try again, use Check Now in Settings › About › Updates." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 자동으로 다시 받지 않으니, 설정 › 정보 › 업데이트의 「지금 확인」 으로 다시 받아 주세요."
          }
        }
      }
    },
    "%@ Settings" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 설정"
          }
        }
      }
    },
    "%@ ago" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 전"
          }
        }
      }
    },
    "%@ and %lld more" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$lld more"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 외 %2$lld개"
          }
        }
      }
    },
    "%@ failed before, so it won’t be downloaded again automatically. Use Check Now to try again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 은 받지 못했던 버전이라 자동으로 다시 받지 않습니다. 「지금 확인」 으로 다시 받을 수 있습니다."
          }
        }
      }
    },
    "%@ is ready. It will be installed when the recording ends." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이 준비됐습니다. 녹화가 끝나면 바꿉니다."
          }
        }
      }
    },
    "%@ is the shortcut for “%@”. Move it to this action?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is the shortcut for “%2$@”. Move it to this action?"
