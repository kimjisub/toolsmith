          }
        }
      }
    },
    "Text and images you copied. Copies marked as passwords and copies from apps you excluded are never kept" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복사한 글자와 그림. 비밀번호로 표시된 복사와 고른 앱의 복사는 남기지 않습니다"
