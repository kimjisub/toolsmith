{
  "sourceLanguage": "en",
  "strings": {
    "NSAudioCaptureUsageDescription": {
      "comment": "Info.plist NSAudioCaptureUsageDescription",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "To change one app's volume, output and effects in Sound, this app needs to receive that app's audio. The audio never leaves this Mac and is never saved."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리 조절에서 앱 하나의 볼륨, 보낼 곳, 효과를 바꾸려면 그 앱의 소리를 받아 와야 합니다. 소리는 이 맥 밖으로 나가지도, 저장되지도 않습니다."
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "comment": "Info.plist NSLocationUsageDescription",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "macOS tells only apps with Location access the name of the connected Wi-Fi network. Your location itself is never read."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 는 위치 권한이 있는 앱에만 연결된 Wi-Fi 이름을 알려 줍니다. 위치 자체는 읽지 않습니다."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Info.plist NSLocationWhenInUseUsageDescription",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "macOS tells only apps with Location access the name of the connected Wi-Fi network. Your location itself is never read."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 는 위치 권한이 있는 앱에만 연결된 Wi-Fi 이름을 알려 줍니다. 위치 자체는 읽지 않습니다."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Info.plist NSMicrophoneUsageDescription",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The microphone is used when you record your voice along with a screen recording."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 녹화에 목소리를 함께 담을 때 마이크를 씁니다."
          }
        }
      }
    }
  },
  "version": "1.0"
}